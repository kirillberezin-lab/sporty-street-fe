# Copy to .env.local and adjust. Values are read by vite.config.js (dev/preview servers).

# Backend behind the /api proxy (backend repo: `docker compose up --build`)
API_TARGET=http://localhost:8080

# Bundled mock backend instead of the real one (same as `npm run dev:mock`)
# MOCK_API=1
# MOCK_API_PORT=8090
# MOCK_MINUTE_MS=2000      # real ms per simulated match minute (backend default: 2 s)
# MOCK_SUB_DELAY_S=60      # substitution activation delay (backend: 60 s)
# MOCK_MEDIA_DIR=../sporty-street/src/main/resources/static/media   # player photos for the mock

# Seeded demo user signed in automatically: alice, bob, carol, dave, eve, frank, grace, henry
VITE_DEMO_USER=alice

# Dev Web Push relay (until the backend sends pushes itself). 0 disables it.
# PUSH_RELAY=1
# VAPID_SUBJECT=mailto:you@example.com

# Absolute public URL, used for the og:image of shared links
# PUBLIC_URL=https://sportystreet.example.com
